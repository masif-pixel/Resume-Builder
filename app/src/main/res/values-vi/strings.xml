    <string name="faq_free_q">Ứng dụng có miễn phí không?</string>
    <string name="faq_free_a">Có. Tất cả mẫu, tùy chọn tùy chỉnh và công cụ PDF đều miễn phí.</string>
    <string name="faq_storage_q">CV của tôi được lưu ở đâu?</string>
    <string name="faq_storage_a">Trên thiết bị của bạn, trong cơ sở dữ liệu riêng tư. Không có gì được tải lên, và gỡ ứng dụng sẽ xóa chúng.</string>
    <string name="faq_ats_q">Các mẫu có thân thiện với ATS không?</string>
    <string name="faq_ats_a">Các mẫu gắn nhãn ATS (Clarity, Compact Pro, Ember) dùng cấu trúc một cột đơn giản mà hệ thống theo dõi ứng viên đọc được chính xác.</string>
    <string name="faq_language_q">Tôi có thể dùng ngôn ngữ của mình không?</string>
    <string name="faq_language_a">Có. Chọn ngôn ngữ CV khi tạo, bằng nút dịch trong trình chỉnh sửa hoặc tại Xem trước › Ngôn ngữ; tiêu đề các mục được dịch và bố cục từ phải sang trái được dùng khi cần. Bạn cũng có thể đổi ngôn ngữ ứng dụng trong Cài đặt.</string>
    <string name="faq_ai_q">Tính năng viết bằng AI hoạt động thế nào?</string>
    <string name="faq_ai_a">Trợ lý viết chạy trên thiết bị và hoạt động ngoại tuyến. Luôn đọc lại văn bản được tạo và kiểm tra thông tin trước khi gửi.</string>
    <string name="faq_pdf_q">Vì sao tôi không chọn được văn bản trong PDF từ công cụ PDF?</string>
    <string name="faq_pdf_a">Gộp, nén, tách và ký sẽ dựng lại các trang trên thiết bị để bảo vệ quyền riêng tư, khiến trang trở thành hình ảnh. CV xuất từ trình chỉnh sửa vẫn giữ văn bản có thể chọn.</string>
    <string name="privacy_store_h">Chúng tôi lưu những gì</string>
    <string name="privacy_store_b">CV, thư xin việc, ảnh và chữ ký bạn tạo được lưu cục bộ trên thiết bị. Tệp bạn xuất được lưu vào bộ nhớ thiết bị.</string>
    <string name="privacy_ai_h">Tính năng AI</string>
    <string name="privacy_ai_b">Soạn thảo bằng AI, nhập CV và tạo thư xin việc đều chạy hoàn toàn trên thiết bị. Không nội dung nào bạn viết được gửi đến máy chủ.</string>
    <string name="privacy_onboarding_h">Thiết lập ban đầu</string>
    <string name="privacy_onboarding_b">Khi thiết lập ban đầu, bạn có thể cho chúng tôi biết bạn tìm thấy ứng dụng qua đâu. Câu trả lời này chỉ được lưu trên thiết bị của bạn.</string>
    <string name="privacy_control_h">Bạn toàn quyền kiểm soát</string>
    <string name="privacy_control_b">Xóa bất kỳ tài liệu nào vào bất cứ lúc nào. Gỡ ứng dụng sẽ xóa toàn bộ dữ liệu của bạn.</string>
    <string name="terms_use_h">Sử dụng ứng dụng</string>
    <string name="terms_use_b">Bạn có thể dùng Resume Builder để tạo tài liệu cho mục đích cá nhân và công việc. Bạn chịu trách nhiệm về độ chính xác của thông tin mình nhập.</string>
    <string name="terms_ai_h">Nội dung do AI tạo</string>
    <string name="terms_ai_b">Gợi ý của AI được cung cấp nguyên trạng. Hãy xem lại và chỉnh sửa nội dung trước khi chia sẻ với nhà tuyển dụng.</string>
    <string name="terms_content_h">Nội dung của bạn</string>
    <string name="terms_content_b">Mọi thứ bạn tạo đều thuộc về bạn. Chúng tôi không yêu cầu quyền đối với CV hay thư xin việc của bạn.</string>
    <string name="terms_availability_h">Tính khả dụng</string>
    <string name="terms_availability_b">Tính năng có thể thay đổi theo thời gian. Chúng tôi cố gắng để tài liệu lưu cục bộ của bạn luôn truy cập được.</string>
