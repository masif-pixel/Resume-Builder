    <string name="faq_free_q">Is the app free?</string>
    <string name="faq_free_a">Yes. Every template, customization option and PDF tool is free to use.</string>
    <string name="faq_storage_q">Where are my resumes stored?</string>
    <string name="faq_storage_a">On your device in a private database. Nothing is uploaded, and uninstalling the app removes them.</string>
    <string name="faq_ats_q">Are the templates ATS-friendly?</string>
    <string name="faq_ats_a">Templates tagged ATS (Clarity, Compact Pro, Ember) use a simple single-column structure that applicant tracking systems read reliably.</string>
    <string name="faq_language_q">Can I use my own language?</string>
    <string name="faq_language_a">Yes. Pick your resume language when you create it, from the translate button in the editor, or under Preview › Language; section titles are translated and right-to-left layout is used where needed. You can also change the app\'s own language in Settings.</string>
    <string name="faq_ai_q">How does AI writing work?</string>
    <string name="faq_ai_a">The writing assistant runs on your device and works offline. Always review generated text and double-check facts before you send it.</string>
    <string name="faq_pdf_q">Why can\'t I select text in PDFs from PDF tools?</string>
    <string name="faq_pdf_a">Merge, compress, split and sign re-render pages on your device for privacy, which turns pages into images. Resumes you export from the editor keep selectable text.</string>
    <string name="privacy_store_h">What we store</string>
    <string name="privacy_store_b">Resumes, cover letters, photos and signatures you create are stored locally on your device. Files you export are saved to your device storage.</string>
    <string name="privacy_ai_h">AI features</string>
    <string name="privacy_ai_b">AI drafting, resume import and cover letter generation run entirely on your device. Nothing you write is sent to a server.</string>
    <string name="privacy_onboarding_h">Onboarding</string>
    <string name="privacy_onboarding_b">During onboarding you may tell us how you found the app. This answer is stored only on your device.</string>
    <string name="privacy_control_h">Your control</string>
    <string name="privacy_control_b">Delete any document at any time. Uninstalling the app removes all of your data.</string>
    <string name="terms_use_h">Using the app</string>
    <string name="terms_use_b">You may use Resume Builder to create documents for personal and professional use. You\'re responsible for the accuracy of the information you include.</string>
    <string name="terms_ai_h">AI-generated content</string>
    <string name="terms_ai_b">AI suggestions are provided as-is. Review and edit generated content before sharing it with employers.</string>
    <string name="terms_content_h">Your content</string>
    <string name="terms_content_b">You own everything you create. We don\'t claim rights to your resumes or cover letters.</string>
    <string name="terms_availability_h">Availability</string>
    <string name="terms_availability_b">Features may change over time. We aim to keep your locally stored documents accessible at all times.</string>
